# Copy this file to ".env" and fill in your real values. Never commit ".env" to source control.

# Anthropic API key — from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# SQL Server connection details
SQL_SERVER=your-server-address.database.windows.net
SQL_DATABASE=your-database-name
SQL_USERNAME=readonly_user
SQL_PASSWORD=your-password
# Driver name must match what's installed on this machine (check with: odbcinst -q -d  on Mac/Linux, or ODBC Data Sources app on Windows)
SQL_DRIVER=ODBC Driver 18 for SQL Server

# Optional: comma-separated list of tables/views the agent is allowed to look at.
# Leave blank to let it discover everything the login can see.
SQL_ALLOWED_TABLES=
